{% extends "core/base.jinja" %}

{%- block additional_css -%}
  <link rel="stylesheet" href="{{ static('user/login.scss') }}">
{%- endblock -%}

{% block title %}{% trans %}Register{% endtrans %}{% endblock %}

{% block nav %}
{% endblock %}

{% block info_boxes %}
{% endblock %}

{% block content %}
  <h1 class="title">{% trans %}Register{% endtrans %}</h1>

  <form action="{{ url('core:register') }}" method="post">
    {% csrf_token %}
    {% render_honeypot_field %}
    {% for field in form %}
      {% if field.name not in ["eula_approved", "captcha"] %}
        <div>{{ field.as_field_group() }}</div>
      {% endif %}
    {% endfor %}
    <div class="captcha">{{ form.captcha.as_field_group() }}</div>
    <fieldset>
      {{ form.eula_approved.errors }}
      {{ form.eula_approved }}
      {{ form.eula_approved.label_tag() }}
    </fieldset>
    <input type="submit" class="btn btn-blue" value="{% trans %}Register{% endtrans %}" />
  </form>
{% endblock %}
