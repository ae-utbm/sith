{% extends "core/base.jinja" %}

{% block additional_css %}
  <link rel="stylesheet" href="{{ static("stock/css/forms.scss") }}">
{% endblock %}

{% block additional_js %}
  <script type="module" src="{{ static("bundled/core/dynamic-formset-index.ts") }}"></script>
{% endblock %}

{% block title %}{% trans %}Create stock item{% endtrans %}{% endblock %}

{% block content %}
  <h2>{% trans %}Create stock items in{% endtrans %}{{ stock.name }}</h2>
  <form method="post" class="stock-form"
        x-data="dynamicFormSet({ prefix: '{{ formset.prefix }}' })">
    {% csrf_token %}
    {{ formset.management_form }}
    <div x-ref="formContainer" class="margin-bottom">
      {% for item_form in formset.forms %}
        <div>
          <fieldset>
            {{ item_form.as_p() }}
            {% if not loop.first %}
              <button type="button" class="btn btn-grey"
                      @click.prevent="removeForm($event.target.closest('div'))">
                <i class="fa fa-minus"></i> {% trans %}Remove{% endtrans %}
              </button>
            {% endif %}
          </fieldset>
          <hr>
        </div>
      {% endfor %}
    </div>
    <template x-ref="formTemplate" class="margin-bottom">
      <div class="margin-bottom">
        <fieldset>
          <div class="margin-bottom">
            {{ formset.empty_form.as_p() }}
          </div>
          <button type="button" class="btn btn-grey"
                  @click.prevent="removeForm($event.target.closest('div'))">
            <i class="fa fa-minus"></i> {% trans %}Remove{% endtrans %}
          </button>
        </fieldset>
        <hr>
      </div>
    </template>
    <div class="row gap margin-bottom">
      <button type="button" class="btn btn-grey" @click.prevent="addForm()">
        <i class="fa fa-plus"></i> {% trans %}Add an item{% endtrans %}
      </button>
      <button type="submit" class="btn btn-blue">{% trans %}Save{% endtrans %}</button>
    </div>
  </form>
{% endblock %}